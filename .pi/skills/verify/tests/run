echo "# builds carry the folder guard"
mkdir -p "$t/unwired/src-tauri/src"
: >"$t/unwired/src-tauri/src/verification.rs"
echo 'let builder = builder.activate_ignoring_other_apps(!verification::instance());' >"$t/unwired/src-tauri/src/app.rs"
git -C "$t/unwired" init -q && git -C "$t/unwired" add -A && git -C "$t/unwired" -c user.name=t -c user.email=t@t commit -qm t
refused "build refuses source whose add_folder skips the folder guard" "doesn't wire in the verification support" "$V" build --src "$t/unwired"
mkdir -p "$t/wired/src-tauri/src"
: >"$t/wired/src-tauri/src/verification.rs"
printf '%s\n' 'activate_ignoring_other_apps(!verification::instance())' 'verification::check_folder' >"$t/wired/src-tauri/src/app.rs"
git -C "$t/wired" init -q && git -C "$t/wired" add -A && git -C "$t/wired" -c user.name=t -c user.email=t@t commit -qm t
wired=$(git -C "$t/wired" rev-parse HEAD | cut -c1-7)
mkdir -p "$root/builds/$wired" && cp "$t/stand-in" "$root/builds/$wired/sifs" && echo keep >"$root/builds/$wired/build.env"
refused "build refuses to reuse or replace a builds folder it didn't create" "didn't create" env PATH="$t/shim:$PATH" "$V" build --src "$t/wired"
expect "and leaves it" test "$(cat "$root/builds/$wired/build.env")" = keep
mkdir -p "$t/decoy/unwired"
refused "build --src resolves a relative folder from here, whatever CDPATH says" "$t/unwired/src-tauri/src/app.rs doesn't wire" \
	env CDPATH="$t/decoy" bash -c 'cd "$1" && "$2" build --src unwired' _ "$t" "$V"

echo "# no mouse, no activation, no signals by number"
forbidden='mouseEventSource|MouseDown|MouseUp|MouseMoved|MouseDragged|scrollWheel|CGWarpMouseCursorPosition|CGDisplayMoveCursor|CGAssociateMouse|\.activate\(|activateIgnoringOtherApps|activateWithOptions|kAXRaiseAction|AXRaise|kAXFrontmostAttribute|AXFrontmost|kAXMainAttribute|AXMain"|setFrontProcess|SetFrontProcess|openApplication|launchApplication'
expect "ax.swift posts no mouse event and activates nothing" bash -c '! grep -nE "$1" "$2"' _ "$forbidden" "$skill/ax.swift"
expect "the scripts drive no other app" bash -c '! grep -nE "tell application|System Events|keystroke|key code|cliclick|click at|\.activate\(|open -a" "$1" "$2"' _ "$V" "$S"
expect "only the supervisor's stopChild sends signals" \
	bash -c '[[ $(grep -c "kill(" "$1") == $(sed -n "/^func stopChild/,/^}/p" "$1" | grep -c "kill(") ]]' _ "$skill/ax.swift"
expect "sifs-verify writes no file in place: no >>, set -C for every >, >| only to a new temporary file" \
	bash -c '! grep -n ">>" "$1" && grep -qx "set -C" "$1" && ! grep -n ">|" "$1" | grep -v ">|\"\$tmp\""' _ "$V"
expect "the scripts send no signals" bash -c '! grep -nwE "kill|pkill|killall" "$1" "$2"' _ "$V" "$S"

echo
if ((failed)); then echo "$failed failed"; exit 1; fi
echo "all passed"
